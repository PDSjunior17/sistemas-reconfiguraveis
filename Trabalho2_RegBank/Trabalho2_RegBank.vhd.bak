LIBRARY IEEE;
USE IEEE.STD_LOGIC_1164.ALL;
USE IEEE.NUMERIC_STD.ALL;

ENTITY Trabalho2_RegBank IS
	PORT(
		a_do   : OUT STD_LOGIC_VECTOR(7 downto 0); -- Saída de dado de um dos registradores selecionado pela entrada a_sel
		b_do   : OUT STD_LOGIC_VECTOR(7 downto 0); -- Saída de dado de um dos registradores selecionado pela entrada b_sel
		nrst   : IN STD_LOGIC := '0'; -- Entrada de reset assíncrono
		clk_in : IN STD_LOGIC; -- Entrada de clock para escrita em todos os registradores
		di     : IN STD_LOGIC_VECTOR(7 downto 0) := (others => '0'); -- Entrada de dados para escrita nos registradores R0 a R3
		a_sel  : IN STD_LOGIC_VECTOR(1 downto 0) := "00"; -- Entrada para selecionar qual registrador vai ser lido na saída a_do 
		-- e será escrito quanto a operação de escrita estiver habilitada por wr_ena.
		b_sel  : IN STD_LOGIC_VECTOR(1 downto 0) := "00"; -- Entrada para selecionar qual registrador vai ser lido na saída b_do
		wr_ena : IN STD_LOGIC := '0'; -- Entrada de habilitação para escrita nos registradores 
	);
END ENTITY Trabalho2_RegBank; 

ARCHITECTURE Reg_Bank OF Trabalho2_RegBank IS
	
	SIGNAL R0, R1, R2, R3 : STD_LOGIC_VECTOR (7 DOWNTO 0);
	
	registrador : PROCESS(nrst, clk_in)
	BEGIN
		IF nrst = '0' THEN
			R0 <= "00000000";
            R1 <= "00000000";
            R2 <= "00000000";
            R3 <= "00000000";
        ELSIF RISING_EDGE(clk_in) THEN
			IF wr_ena = '1' THEN
				CASE a_sel IS
					WHEN "00" => R0 <= di;
                    WHEN "01" => R1 <= di;
                    WHEN "10" => R2 <= di;
                    WHEN "11" => R3 <= di;
				END CASE;
			END IF;
		END IF;
	END PROCESS registrador;
	
	WITH a_sel SELECT
		a_do <= R0 WHEN "00",
				R1 WHEN "01",
				R2 WHEN "10",
				R3 WHEN "11";
	
	WITH b_sel SELECT
		b_do <= R0 WHEN "00",
				R1 WHEN "01",
				R2 WHEN "10",
				R3 WHEN "11";
				
END ARCHITECTURE Reg_Bank;	