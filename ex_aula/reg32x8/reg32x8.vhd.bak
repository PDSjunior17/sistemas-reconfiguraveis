LIBRARY ieee;
USE ieee.std_logic_1164.all;
USE ieee.numeric_std.all;
-------------------------------------------------------
ENTITY reg32x8 IS
PORT (
nclr : IN STD_LOGIC;
clk : IN STD_LOGIC;
wr_en : IN STD_LOGIC;
d : IN STD_LOGIC_VECTOR(7 DOWNTO 0);
addr : IN STD_LOGIC_VECTOR(4 DOWNTO 0);
q : OUT STD_LOGIC_VECTOR(7 DOWNTO 0)
);
END ENTITY;
-------------------------------------------------------